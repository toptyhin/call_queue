{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-result.schema.json",
  "title": "AnalysisResult",
  "description": "Финальный результат разбора звонка (ТЗ 7.3). Единый источник истины: из этого файла кодогенерируются Pydantic-модель сервера и zod-схема клиента (make codegen). Руками сгенерированное не править.",
  "type": "object",
  "required": ["summary", "objections", "next_step", "lead_score", "confidence"],
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "description": "Краткое резюме звонка"
    },
    "objections": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Возражения клиента"
    },
    "next_step": {
      "type": "string",
      "enum": ["call_back", "send_proposal", "disqualify", "escalate"],
      "description": "Рекомендуемый следующий шаг"
    },
    "lead_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Оценка лида, 0..100"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Уверенность модели, 0..1"
    }
  }
}
